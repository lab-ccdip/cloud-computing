<!DOCTYPE html>
<html>
<head>
    <title>My Cafe</title>

    <style>
        body {
            font-family: Arial;
            background: #fff8f0;
            margin: 0;
            text-align: center;
        }

        header {
            background: brown;
            color: white;
            padding: 15px;
        }

        nav a {
            color: white;
            margin: 10px;
            text-decoration: none;
        }

        #home {
            background: burlywood;
            padding: 50px;
            color: white;
        }

        .products {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
            padding: 20px;
        }

        .card {
            background: white;
            padding: 20px;
            width: 150px;
            border: 1px solid gray;
            border-radius: 10px;
        }

        button {
            background: brown;
            color: white;
            padding: 10px;
            border: none;
            cursor: pointer;
        }

        #contact {
            background: beige;
            padding: 20px;
        }
    </style>
</head>

<body>

    <header>
        <h1>My Cafe</h1>
        <nav>
            <a href="#home">Home</a>
            <a href="#menu">Menu</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <section id="home">
        <h2>Welcome to My Cafe</h2>
        <p>Enjoy Fresh Coffee and Delicious Food</p>
    </section>

    <section id="menu">
        <h2>Our Menu</h2>

        <div class="products">

            <div class="card">
                <h3>Coffee</h3>
                <p>Price: Rs.50</p>
                <button onclick="order('Coffee')">Order Now</button>
            </div>

            <div class="card">
                <h3>Pizza</h3>
                <p>Price: Rs.120</p>
                <button onclick="order('Pizza')">Order Now</button>
            </div>

            <div class="card">
                <h3>Burger</h3>
                <p>Price: Rs.80</p>
                <button onclick="order('Burger')">Order Now</button>
            </div>

            <div class="card">
                <h3>Cake</h3>
                <p>Price: Rs.60</p>
                <button onclick="order('Cake')">Order Now</button>
            </div>

        </div>
    </section>

    <section id="contact">
        <h2>Contact Us</h2>
        <p>Email: mycafe@gmail.com</p>
        <p>Phone: 9876543210</p>
    </section>

    <script>
        function order(item) {
            alert(item + " ordered successfully!");
        }
    </script>

</body>
</html>
