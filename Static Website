<!DOCTYPE html>
<html>
<head>
    <title>My Cafe</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #fff8f0;
        }

        header {
            background-color: #4b2e20;
            color: white;
            padding: 20px;
            display: flex;
            justify-content: space-between;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 10px;
        }

        #home {
            text-align: center;
            padding: 80px 20px;
            background-color: #d9a066;
            color: white;
        }

        #home h2 {
            font-size: 35px;
            margin-bottom: 15px;
        }

        .btn {
            display: inline-block;
            background-color: #4b2e20;
            color: white;
            padding: 12px 20px;
            margin-top: 20px;
            text-decoration: none;
            border-radius: 5px;
        }

        #menu {
            text-align: center;
            padding: 40px;
        }

        .products {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 25px;
        }

        .card {
            background-color: white;
            padding: 25px;
            width: 200px;
            border-radius: 10px;
            box-shadow: 0 2px 8px gray;
        }

        .card h3 {
            margin-bottom: 15px;
        }

        .card p {
            margin-bottom: 15px;
        }

        button {
            background-color: #4b2e20;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background-color: #d9a066;
        }

        #contact {
            background-color: #eee0d0;
            text-align: center;
            padding: 30px;
        }

        #contact p {
            margin: 10px;
        }

        footer {
            background-color: #4b2e20;
            color: white;
            text-align: center;
            padding: 15px;
        }
    </style>
</head>

<body>

    <header>
        <h1> My Cafe</h1>

        <nav>
            <a href="#home">Home</a>
            <a href="#menu">Menu</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <section id="home">
        <h2>Welcome to My Cafe</h2>
        <p>Enjoy Fresh Coffee and Delicious Food</p>

        <a href="#menu" class="btn">View Menu</a>
    </section>

    <section id="menu">
        <h2>Our Menu</h2>

        <div class="products">

            <div class="card">
                <h3> Coffee</h3>
                <p>Price: Rs.50</p>
                <button onclick="order('Coffee')">
                    Order Now
                </button>
            </div>

            <div class="card">
                <h3> Pizza</h3>
                <p>Price: Rs.120</p>
                <button onclick="order('Pizza')">
                    Order Now
                </button>
            </div>

            <div class="card">
                <h3> Burger</h3>
                <p>Price: Rs.80</p>
                <button onclick="order('Burger')">
                    Order Now
                </button>
            </div>

            <div class="card">
                <h3> Cake</h3>
                <p>Price: Rs.60</p>
                <button onclick="order('Cake')">
                    Order Now
                </button>
            </div>

        </div>
    </section>

    <section id="contact">
        <h2>Contact Us</h2>
        <p>Email: mycafe@gmail.com</p>
        <p>Phone: 9876543210</p>
    </section>

    <footer>
        <p>© 2026 My Cafe. All Rights Reserved.</p>
    </footer>

    <script>
        function order(product) {
            alert(product + " ordered successfully!");
        }
    </script>

</body>
</html>
```
